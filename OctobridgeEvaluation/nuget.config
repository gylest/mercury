<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Official NuGet Gallery (Restores standard packages like Newtonsoft.Json, Microsoft.*, etc.) -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Your GitHub Packages Feed -->
    <add key="GitHub-gylest" value="https://nuget.pkg.github.com/gylest/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <GitHub-gylest>
      <add key="Username" value="%GH_USERNAME%" />
      <add key="ClearTextPassword" value="%GH_TOKEN%" />
    </GitHub-gylest>
  </packageSourceCredentials>
</configuration>