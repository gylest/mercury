<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\angular.client</SpaRoot>
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:63498</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Data" />
    <Using Include="System.Net.Http.Headers" />
    <Using Include="System.Text.Json" />
    <Using Include="Microsoft.AspNetCore.Mvc" />
    <Using Include="Microsoft.Data.SqlClient" />
    <Using Include="AngularServer.Models" />
    <Using Include="AngularServer.Services" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.0.13</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    <!-- Removed explicit Microsoft.OpenApi reference to avoid source-generator API mismatch; rely on Microsoft.AspNetCore.OpenApi's compatible version -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Angular.Client\Angular.Client.esproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

</Project>
